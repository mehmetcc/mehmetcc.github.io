---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { config } from "../../config";
import { tagToSlug } from "../../utils/tags";

const allPosts = await getCollection("posts");
const allTags = allPosts.flatMap((post) => post.data.tags || []);
const uniqueTags = [...new Set(allTags)];
---

<Layout title="Categories" description="Browse posts by category">
  <article>
    <h1>Categories</h1>
    <div class="tag-list">
      {uniqueTags.map((tag, index) => (
        <>
          <a href={`/categories/${tagToSlug(tag)}`}>{tag}</a>
          {index < uniqueTags.length - 1 && ' · '}
        </>
      ))}
    </div>
  </article>
</Layout>

<style>
  .tag-list {
    font-size: 1.2em; /* Larger font size for the main categories page */
    color: var(--color-subtle);
    margin-top: 1rem;
    text-align: left;
    line-height: 2;
  }

  .tag-list a {
    color: var(--color-subtle);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .tag-list a:hover {
    color: var(--color-black);
  }
</style>
